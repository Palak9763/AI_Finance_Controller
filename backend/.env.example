# Optional. If unset, the AI investigation agent uses the rule-based Demo AI Provider
# (no external network calls) and the demo remains fully functional.
OPENAI_API_KEY=

# Optional. Defaults to a local SQLite file. Point this at Postgres/Supabase to switch
# data layers without any code changes (same SQLAlchemy schema).
DATABASE_URL=sqlite:///./finance_controller.db
